# dependencies
node_modules/
.pnp
.pnp.js

# testing
coverage/

# next.js
.next/
out/
dist/

# production
build/

# env files - NEVER commit real credentials
.env
.env.local
.env.*.local
.env.example

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel

# PWA service worker - generated by @serwist/next at build time, not source
public/sw.js
public/sw.js.map
public/swe-worker-*.js
public/swe-worker-*.js.map

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
prisma/dev.db

# whatsapp bot session (contains auth credentials, never commit)
storage/bot-session/
storage/local/*
!storage/local/.gitkeep

# uploads / exports / backup - runtime data, never commit
uploads/*
!uploads/.gitkeep
exports/*
!exports/.gitkeep
backup/*
!backup/.gitkeep

# logs
logs/
*.log

# IDE
.vscode/*
!.vscode/extensions.json
.idea/
