{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": "../dist/bot",
    "rootDir": "..",
    "paths": {
      "@/*": ["../*"]
    }
  },
  "include": ["../bot/**/*.ts", "../lib/**/*.ts", "../services/**/*.ts", "../repositories/**/*.ts", "../types/**/*.ts", "../config/**/*.ts"],
  "exclude": ["../node_modules", "../app", "../components"]
}