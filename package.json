{
  "name": "whatsapp-agenda-system",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise WhatsApp Work Management System - Full Stack Next.js 15",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p bot/tsconfig.json",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "tsx prisma/seed/index.ts",
    "db:reset": "prisma migrate reset --force",
    "bot:dev": "tsx watch bot/index.ts",
    "bot:start": "node dist/bot/index.js",
    "bot:build": "tsc -p bot/tsconfig.json",
    "prepare": "node -e \"try{require('husky')}catch(e){process.exit(0)}\" && husky || true",
    "postinstall": "prisma generate"
  },
