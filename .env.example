# ==============================================================================
# WHATSAPP AGENDA & WORK MANAGEMENT SYSTEM - ENVIRONMENT VARIABLES
# Copy this file to .env and fill in real values. NEVER commit .env to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME="WhatsApp Agenda System"
APP_TIMEZONE=Asia/Jakarta
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL)
# ------------------------------------------------------------------------------
# POSTGRES_USER/PASSWORD/DB dipakai oleh docker-compose.yml untuk membuat container
# lokal. PENTING: file .env tidak bisa saling mereferensikan variabel lain, jadi
# jika Anda ganti nilai di bawah ini, WAJIB update juga password di dalam
# DATABASE_URL/DIRECT_DATABASE_URL agar tetap sinkron.
POSTGRES_USER=agenda_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=whatsapp_agenda

# Local development (matches docker-compose.yml via POSTGRES_* above)
DATABASE_URL="postgresql://neondb_owner:npg_HlBaZXDw1h2v@ep-icy-firefly-axgc1mj6-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
AUTHOR_DATABASE_URL="https://ep-icy-firefly-axgc1mj6.neonauth.c-4.us-east-2.aws.neon.tech/neondb/auth"
# Direct connection URL for Prisma migrations if using connection pooling (e.g. pgbouncer) in production
DIRECT_DATABASE_URL="postgresql://agenda_user:CHANGE_ME_STRONG_PASSWORD@localhost:5432/whatsapp_agenda?schema=public"

# ------------------------------------------------------------------------------
# AUTH.JS (NextAuth v5)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3000
# Session max age in seconds (default 30 days)
AUTH_SESSION_MAX_AGE=2592000

# ------------------------------------------------------------------------------
# SECURITY
# ------------------------------------------------------------------------------
# Used for encrypting backups, signing internal tokens, etc. 32 bytes hex.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
# Rate limiting window (requests per window per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Redis is used for rate limiting and bot session/job queue coordination
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# GOOGLE DRIVE API (Service Account - primary storage per system requirement)
# ------------------------------------------------------------------------------
# Create a Service Account in Google Cloud Console, enable Drive API,
# share the target Drive folder with the service account email.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the full private key (keep \n literal escapes, they are unescaped at runtime)
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCHANGE_ME\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_ROOT_FOLDER_ID=CHANGE_ME_ROOT_FOLDER_ID
GOOGLE_PROJECT_ID=your-gcp-project-id
# Token acak yang dikirim balik Google di setiap push notification webhook, untuk verifikasi.
# Generate dengan: openssl rand -hex 24
GOOGLE_DRIVE_WEBHOOK_TOKEN=CHANGE_ME_RANDOM_TOKEN

# ------------------------------------------------------------------------------
# WHATSAPP BOT (Baileys)
# ------------------------------------------------------------------------------
BOT_SESSION_DIR=./storage/bot-session
BOT_ADMIN_NUMBERS=6289515420437
BOT_LOG_LEVEL=info
BOT_RECONNECT_MAX_ATTEMPTS=10
BOT_RECONNECT_BASE_DELAY_MS=2000
BOT_COMMAND_TIMEOUT_MS=300000
BOT_HEALTHCHECK_PORT=3001

# ------------------------------------------------------------------------------
# FILE STORAGE
# ------------------------------------------------------------------------------
# 'local' now, can switch to 's3' later without changing application code
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/local
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_MIME_TYPES=image/jpeg,image/png,image/webp,video/mp4,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ------------------------------------------------------------------------------
# BACKUP
# ------------------------------------------------------------------------------
BACKUP_DIR=./backup
BACKUP_CRON_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPT=true

# ------------------------------------------------------------------------------
# EXPORT
# ------------------------------------------------------------------------------
EXPORT_DIR=./exports
EXPORT_RETENTION_DAYS=14

# ------------------------------------------------------------------------------
# INITIAL SEED (only used once by `npm run prisma:seed` to create the first admin login)
# ------------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_MIN_8_CHARS

# ------------------------------------------------------------------------------
# EMAIL (optional, disabled by default)
# ------------------------------------------------------------------------------
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="WhatsApp Agenda System <no-reply@yourdomain.com>"
